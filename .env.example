# Copy to .env and fill in. Requires Google 2-Step Verification + an App Password
# (myaccount.google.com -> Security -> App passwords -> generate one for "Mail").
OWNER_EMAIL=yadavanandraj304@gmail.com
GMAIL_USER=yadavanandraj304@gmail.com
GMAIL_APP_PASSWORD=
PORT=3001

# --- Supabase (Service Inquiry Form writes into the `inquiries` table) ---
# Create the project with your email (yadavanandraj304@gmail.com), run
# supabase/schema.sql in the SQL Editor, then paste Project Settings -> API:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Infisical ---
# Real values live in your Infisical project (Development environment). This file
# only documents the keys the app reads. Start the app with `npm run dev` /
# `npm run server`, which wrap the process in `infisical run`.
# See https://infisical.com/docs/documentation/platform/secrets-mgmt/quick-starts/deliver-first-secret

# --- Admin panel sign-in (read by server/index.js) ---
