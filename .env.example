[TEMPLATE]
# Copy to .env and fill in. Requires Google 2-Step Verification + an App Password
# (myaccount.google.com -> Security -> App passwords -> generate one for "Mail").
OWNER_EMAIL=hitechrajesh2023@gmail.com

# --- Email (option 1 — recommended): Gmail App Password ----------------------
GMAIL_USER=yadavanandraj304@gmail.com
GMAIL_APP_PASSWORD=

# --- Email (option 2): any SMTP provider (Brevo, Mailgun, Zoho…) -------------
# If SMTP_HOST is set it wins over Gmail. Port 587 = STARTTLS, 465 = implicit TLS.
# SMTP_USER/SMTP_PASS are optional only for relays that need no auth.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
#
# Missing credentials never crash the server: inquiries are always saved to
# server/data/inquiries.json and visible in the admin dashboard — only the
# email notification is skipped (a warning is printed at startup).

# --- Server binding -----------------------------------------------------------
# Leave both empty. On Render/Railway/Fly/Heroku the server auto-binds 0.0.0.0
# and uses the platform's PORT (Render default 10000). Locally it stays on
# 127.0.0.1:3001 for the Vite dev proxy. Set these only to override.
# HOST=
# PORT=3001

# --- Supabase (Service Inquiry Form writes into the `inquiries` table) ---
# Create the project with your email (yadavanandraj304@gmail.com), run
# supabase/schema.sql in the SQL Editor, then paste Project Settings -> API:
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Infisical ---
# Real values live in your Infisical project (Development environment). This file
# only documents the keys the app reads. Start the app with `npm run dev` /
# `npm run server`, which wrap the process in `infisical run`.
# See https://infisical.com/docs/documentation/platform/secrets-mgmt/quick-starts/deliver-first-secret

# --- Admin panel sign-in (read by server/index.js) ---
ADMIN_EMAIL=hitechrajesh2023@gmail.com
ADMIN_PASSWORD=
